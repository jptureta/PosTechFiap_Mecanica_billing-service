  "components": {
    "schemas": {
      "CreateQuote": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/QuoteItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "customer_id",
          "items"
        ],
        "title": "CreateQuote"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentVerification": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "provider_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Provider Reference"
          }
        },
        "type": "object",
        "required": [
          "status",
          "provider_reference"
        ],
        "title": "PaymentVerification"
      },
      "QuoteItem": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "PART",
              "SERVICE"
            ],
            "title": "Kind",
            "default": "PART"
          },
          "sku": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Unit Price"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "name",
          "quantity",
          "unit_price"
        ],
        "title": "QuoteItem"
      },
      "QuoteResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "string",
            "title": "Total"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "notification_sent": {
            "type": "boolean",
            "title": "Notification Sent",
            "default": false
          },
          "notification_channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notification Channel",
            "default": "EMAIL"
          },
          "notification_sent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notification Sent At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_id",
          "customer_id",
          "items",
          "total",
          "status",
          "created_at"
        ],
        "title": "QuoteResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}